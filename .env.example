# Copy this file to .env and fill in real values. Never commit .env to git.

PORT=3000

# SMTP credentials for sending the shop a notification email on each booking.
# Any SMTP provider works — Gmail (with an app password), Zoho, SendGrid,
# Mailgun, etc. Example values shown are for Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=youraccount@gmail.com

# Where booking notifications get sent
SHOP_NOTIFICATION_EMAIL=majorinkstudios@example.com

# Key required to view /api/bookings in a browser as a simple submissions list
ADMIN_KEY=choose-a-long-random-string

# Exact URL of the live website (no trailing slash), so the browser is
# allowed to call this API from that domain. Leave blank while testing
# locally; set it once the site is deployed, e.g.:
# ALLOWED_ORIGIN=https://major-ink-studios.netlify.app
ALLOWED_ORIGIN=
