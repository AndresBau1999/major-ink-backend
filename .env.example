# Copy this file to .env and fill in real values. Never commit .env to git.

PORT=3000

# Resend (https://resend.com) sends the booking notification email over
# HTTPS — not SMTP, which Railway blocks on Free/Trial/Hobby plans.
# Sign up free, then find your API key at resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Who the notification email appears to come from. Until you verify your
# own domain on Resend, you must use their shared address below — it only
# works when sending TO the same email address you signed up to Resend
# with. Once you verify a domain (e.g. majorinkstudios.com) on Resend,
# change this to something like bookings@majorinkstudios.com and you can
# send to any address.
RESEND_FROM_EMAIL=onboarding@resend.com

# Where booking notifications get sent
SHOP_NOTIFICATION_EMAIL=majorinkstudios01@gmail.com

# Key required to view /api/bookings in a browser as a simple submissions list
ADMIN_KEY=choose-a-long-random-string

# Exact URL of the live website (no trailing slash), so the browser is
# allowed to call this API from that domain. Leave blank while testing
# locally; set it once the site is deployed, e.g.:
# ALLOWED_ORIGIN=https://majorinkstudios.netlify.app
ALLOWED_ORIGIN=
